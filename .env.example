# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# MongoDB Configuration (Replace with MongoDB Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventify?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/eventify

# JWT Security
JWT_SECRET=replace_with_a_strong_64_char_secret_key_for_eventify_jwt
JWT_EXPIRE=7d

# Razorpay Payment Gateway (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_email@example.com
SMTP_PASS=your_smtp_password
FROM_NAME=EVENTIFY Smart Events
FROM_EMAIL=noreply@eventify.com

# Cloudinary Optional Cloud Image Storage (For Production Deployment)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Eventify AI Chat Assistant (Optional OpenAI API Integration; falls back to MongoDB Smart Assistant when unset)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


